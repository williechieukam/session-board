{
  "name": "Sessionboard",
  "short_name": "Sessionboard",
  "description": "A sticky-note board for running a workshop from one screen.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#edf1f3",
  "theme_color": "#005b80",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
